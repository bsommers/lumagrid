  "ico": {
    "out": "site/public/favicon.ico",
    "images": [
      "site/public/favicon-16.png",
      "site/public/favicon-32.png"
    ]
  },
  "copies": [
    {
      "src": "brand/favicon.svg",
      "out": "site/public/favicon.svg"
    }
  ],
  "manifest": {
    "out": "site/public/site.webmanifest",
    "content": {
      "name": "Lumagrid",
      "short_name": "Lumagrid",
      "description": "Themeable, pluggable data widgets for React",
      "start_url": "./",
      "scope": "./",
      "display": "standalone",
      "background_color": "#000000",
      "theme_color": "#05070A",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "icon-512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  }
}
