{
  "name": "lumagrid",
  "version": "0.1.1",
  "description": "Layered React + TypeScript UI library for data visualization widgets",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./transforms": {
      "types": "./dist/esm/transforms/index.d.ts",
      "import": "./dist/esm/transforms/index.js",
      "require": "./dist/cjs/transforms/index.js"
    },
    "./theme": {
      "types": "./dist/esm/theme/index.d.ts",
      "import": "./dist/esm/theme/index.js",
      "require": "./dist/cjs/theme/index.js"
    },
    "./viz": {
      "types": "./dist/esm/viz/index.d.ts",
      "import": "./dist/esm/viz/index.js",
      "require": "./dist/cjs/viz/index.js"
    },
    "./plugins": {
      "types": "./dist/esm/plugins/index.d.ts",
      "import": "./dist/esm/plugins/index.js",
      "require": "./dist/cjs/plugins/index.js"
    },
    "./testing": {
      "types": "./dist/esm/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "examples:build": "vite build --config examples/vite.config.ts",
    "examples:dev": "vite --config examples/vite.config.ts",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "docs:api": "typedoc",
    "api:check": "bash scripts/api.sh check",
    "api:update": "npm run build:esm && bash scripts/api.sh update",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "typecheck:site": "tsc -p site/tsconfig.json --noEmit && tsc -p docs/guide/snippets/tsconfig.json --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "visuals": "node scripts/render-visuals.mjs",
    "visuals:check": "node scripts/check-visuals.mjs",
    "screenshots": "node scripts/render-screenshots.mjs",
    "brand": "node scripts/brand/compose.mjs && node scripts/build-brand.mjs",
    "brand:check": "node scripts/check-brand.mjs"
  },
  "peerDependencies": {
    "@nivo/bar": ">=0.99.0",
    "d3": ">=7.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "recharts": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@nivo/bar": {
      "optional": true
    },
    "d3": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/orbitron": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@microsoft/api-extractor": "7.60.1",
    "@nivo/bar": "0.99.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^15.0.0",
    "@types/d3": "^7.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "d3": "7.9.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "opentype.js": "2.0.0",
    "playwright-core": "1.64.1",
    "recharts": "3.10.1",
    "typedoc": "0.28.20",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "react",
    "visualization",
    "charts",
    "dataviz",
    "ui-library",
    "deno",
    "lumagrid"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsommers/lumagrid.git"
  },
  "homepage": "https://bsommers.github.io/lumagrid/",
  "bugs": {
    "url": "https://github.com/bsommers/lumagrid/issues"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
